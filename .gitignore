# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
build/
dist/

# Environment / secrets
.env
.env.*
!.env.example
.env.local

# Local caches and results (regenerable)
data/
*.sqlite3*
coverage.json
.coverage
# unlevered_v1 raw panel snapshots (36MB, regenerable via
# research/data/fetch_panel.py; sha256s recorded in the tracked
# coverage_report.json + P1_QUALIFICATION.md). Anchored patterns + parent
# negations (cboe_options precedent) because the un-anchored `data/` rule
# would otherwise exclude the parent.
!research/data/
research/data/panel/*
!research/data/panel/coverage_report.json
# frozen risk-free reference (DGS3MO feed snapshot) — tracked as the
# evaluation input so metric reproduction does not depend on FRED refetch
!research/data/panel/DGS3MO.csv
!research/data/panel/DGS10.csv

# Real-data history cache (regenerable via tools/quant/data_history.py)
# (/* patterns + parent negations keep the archive subtree re-includable;
# the un-anchored `data/` rule above would otherwise exclude the parent)
!tools/quant/data/
tools/quant/data/*
!tools/quant/data/cboe_options/
tools/quant/data/cboe_options/*
!tools/quant/data/cboe_options/archive/
# CBOE daily option-chain snapshots are irreplaceable (no refetch after
# the session) — always track the per-date archives
!tools/quant/data/cboe_options/archive/**
# ...but the regenerable cache files next to them stay ignored
tools/quant/data/cboe_options/cache/
# L/S backtest results (regenerable, 133MB+)
tools/quant/ls/results/
# bigmove regenerable data caches (parquet feature/prediction caches, 363MB)
tools/quant/bigmove/data/
Stock Accounts Information .pdf
# backup copy of the same personal financial document — never commit
Stock Accounts Information .pdf.bak
# IBKR portal login screenshots (credentials shown) — never commit
ibkr_paper_portal_*.png
# per-project playwright browser-session logs (regenerable)
.playwright-mcp/
.tmp/
